      <Text style={{ fontSize: 16, color: '#B9CCEC' }}>03 · Platform</Text>
    </Box>
    <Box style={{ height: 1, background: '#D6DCE5' }} />
  </Box>

  <Box style={{ flex: 1, paddingTop: 24, flexDirection: 'row', gap: 36 }}>
    <Box style={{ flex: 1 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1E4FA8' }}>本阶段已完成</Text>
      <Box style={{ marginTop: 16 }}>
        <Box style={{ flexDirection: 'row', gap: 12, marginBottom: 16 }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E4FA8', width: 86 }}>数据库改造</Text>
          <Text style={{ fontSize: 17, color: '#4A5568', flex: 1, lineHeight: 1.5 }}>规范为 9 张核心表，建立桥隧—路网绑定关系</Text>
        </Box>
