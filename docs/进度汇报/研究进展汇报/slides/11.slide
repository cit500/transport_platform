        <Box style={{ flexDirection: 'row', gap: 12, marginBottom: 16 }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E4FA8', width: 86 }}>架构补齐</Text>
          <Text style={{ fontSize: 17, color: '#4A5568', flex: 1, lineHeight: 1.5 }}>Python 辅助计算服务、用户权限管理</Text>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 12 }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E4FA8', width: 86 }}>能力补齐</Text>
          <Text style={{ fontSize: 17, color: '#4A5568', flex: 1, lineHeight: 1.5 }}>成果导出、异步任务调度与运行监控</Text>
