      <Text style={{ fontSize: 16, color: '#B9CCEC' }}>02 · Timeline</Text>
    </Box>
    <Box style={{ height: 1, background: '#D6DCE5' }} />
  </Box>

  <Box style={{ flex: 1, paddingTop: 22 }}>
    <Text style={{ fontSize: 20, color: '#1A2230', marginBottom: 18 }}>三条线并行推进，7 月启动至今已完成两轮阶段性节点</Text>

    <Box style={{ flexDirection: 'row', gap: 16, marginBottom: 16 }}>
      <Box style={{ width: 138 }}>
