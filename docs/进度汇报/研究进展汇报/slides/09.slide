          <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, marginTop: 6 }}>项目启动<br />分工与节奏明确</Text>
        </Box>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderLeft: '3px solid #1E4FA8', padding: 12, height: 106 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>08-12</Text>
          <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, marginTop: 6 }}>架构确立<br />一个首页 + 三模块</Text>
        </Box>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderLeft: '3px solid #1E4FA8', padding: 12, height: 106 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>10-16</Text>
          <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, marginTop: 6 }}>云端部署完成<br />公网可直接访问</Text>
        </Box>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderLeft: '3px solid #1E4FA8', padding: 12, height: 106 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>10-28</Text>
          <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, marginTop: 6 }}>灾害模块<br />专业化重构完成</Text>
        </Box>
      </Box>
    </Box>

    <Box style={{ flexDirection: 'row', gap: 16, marginBottom: 16 }}>
      <Box style={{ width: 138 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1.4 }}>灾害<br />莫东霖</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'row', gap: 12 }}>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderLeft: '3px solid #1E4FA8', padding: 12, height: 106 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>08-06</Text>
          <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, marginTop: 6 }}>地震易损性<br />分析框架建立</Text>
        </Box>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderLeft: '3px solid #1E4FA8', padding: 12, height: 106 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>09-23</Text>
          <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, marginTop: 6 }}>桥梁易损性<br />计算流程跑通</Text>
        </Box>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderLeft: '3px solid #1E4FA8', padding: 12, height: 106 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>10-20</Text>
          <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, marginTop: 6 }}>泥石流改为<br />发生倾向预测</Text>
        </Box>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderLeft: '3px solid #1E4FA8', padding: 12, height: 106 }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>11-03</Text>
          <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.5, marginTop: 6 }}>桥梁隧道地震<br />阶段成果完成</Text>
        </Box>
      </Box>
    </Box>

    <Box style={{ flexDirection: 'row', gap: 16 }}>
      <Box style={{ width: 138 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1.4 }}>韧性<br />周星羽</Text>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'row', gap: 12 }}>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderLeft: '3px solid #1E4FA8', padding: 12, height: 106 }}>
