      </Box>
      <Box style={{ flex: 1, flexDirection: 'row', gap: 12 }}>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderLeft: '3px solid #1E4FA8', padding: 12, height: 106 }}>
